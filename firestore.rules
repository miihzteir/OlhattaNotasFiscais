rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /olhatta/{docId} {
      allow read, write: if request.auth != null
        && request.auth.token.email in [
          'francimeryapfachini@gmail.com',
          'draoftalmologistavet@gmail.com',
          'miihrietz@gmail.com'
        ];
    }
  }
}
